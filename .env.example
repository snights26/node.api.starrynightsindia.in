NODE_ENV=development
PORT=8080
# Required for Vercel Preview/Production. NODE_ENV is not sufficient because
# Vercel sets it to production in both environments.
DEPLOYMENT_ENVIRONMENT=local
DATABASE_ENVIRONMENT=local

# Runtime connection; do not use this API to run schema changes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

JWT_SECRET=replace-with-a-32-character-minimum-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ADMIN_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
PUBLIC_PASSWORD_LOGIN_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=false

GOOGLE_AUTH_ENABLED=false
# Comma-separated explicit allowlist for browser, Android and iOS OAuth client IDs.
# GOOGLE_CLIENT_ID remains a temporary single-client migration fallback and is added to the allowlist when set.
GOOGLE_ALLOWED_CLIENT_IDS=
GOOGLE_CLIENT_ID=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional non-secret prefix for new uploads; set different staging/production values when sharing an account.
CLOUDINARY_FOLDER_PREFIX=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_SUPPORT_TO=
SMTP_HR_TO=
SMTP_SALES_TO=
SMTP_SECURE=false
SMTP_STARTTLS=true

# Legacy payment mailer mapping. Required only when payment-link/receipt mail is enabled.
SMTP_PAYMENT_HOST=
SMTP_PAYMENT_PORT=587
SMTP_PAYMENT_USERNAME=
SMTP_PAYMENT_PASSWORD=
SMTP_PAYMENT_FROM=
SMTP_PAYMENT_SECURE=false
SMTP_PAYMENT_STARTTLS=true

# Legacy quotation mailer mapping. The current legacy workflow intentionally uses the
# system transport as a fallback for quotations; retain this only for a future approved change.
SMTP_QUOTATION_HOST=
SMTP_QUOTATION_PORT=587
SMTP_QUOTATION_USERNAME=
SMTP_QUOTATION_PASSWORD=
SMTP_QUOTATION_FROM=
SMTP_QUOTATION_SECURE=false
SMTP_QUOTATION_STARTTLS=true

RAZORPAY_ENABLED=false
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK_EXPIRY_HOURS=48

UPLOAD_MAX_FILE_SIZE_BYTES=26214400
# Vercel Functions never receive large binary files. Existing multipart
# compatibility routes are limited to 4 MB; direct Blob upload preserves the
# product-level limits below.
FUNCTION_UPLOAD_MAX_SIZE_BYTES=4194304
PRIVATE_ATTACHMENT_MAX_SIZE_BYTES=10485760

# Durable Vercel Blob storage. A Vercel Function activates OIDC automatically
# when it receives a selected store ID; do not set VERCEL_OIDC_TOKEN yourself.
# BLOB_STORE_ID is the official single-store integration name and is used as a
# private-store fallback. Separate private/public IDs are neutral application
# configuration for deployments that use two stores.
STORAGE_NAMESPACE=local/starry-nights
BLOB_STORE_ID=
BLOB_PRIVATE_STORE_ID=
BLOB_PUBLIC_STORE_ID=
# Local migration shells may use a scoped server-only token only when OIDC is
# unavailable. Do not add these to Vercel Functions, browsers, or Expo builds.
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_UPLOAD_INTENT_MINUTES=15
BLOB_DOWNLOAD_URL_MINUTES=15

# Preview/staging must use disabled or safe. Safe mode permits delivery only
# to recipients listed here; it never redirects customer mail.
MAIL_DELIVERY_MODE=disabled
SMTP_SAFE_RECIPIENTS=

# One-time migration only; do not set these in Vercel Production.
LEGACY_UPLOAD_ARCHIVE=
LEGACY_UPLOAD_MIGRATION_CONFIRM=
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=1000
# Set to a shared, new deployment identifier whenever browser-visible data is released.
# Required for a multi-replica staging/production deployment; never use a secret value.
PUBLIC_BROWSER_CACHE_EPOCH=replace-on-each-staging-or-production-deployment
SEMANTIC_SEARCH_ENABLED=false
